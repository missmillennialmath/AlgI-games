r:#e3a9ec}.tokens{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding-top:10px}.token{min-height:90px;border:3px solid #c65ae9;border-radius:10px;background:#efb2ed;color:#1e1225;box-shadow:3px 4px #0d0714;position:relative;animation:sway 2.2s ease-in-out infinite;animation-delay:calc(var(--i)*-.45s);touch-action:manipulation}.token span{display:block;font-size:clamp(16px,2.5vw,25px)}.token small{display:block;font-size:11px}.token:hover{background:var(--green)}.token.wrong{background:#ff7c91;animation:shake .25s}.token.correct{background:var(--green)}.speed-chill .token{animation:none}.speed-rush .token{animation-duration:1.6s}.speed-chaos .token{animation-duration:.9s}@keyframes sway{0%,100%{transform:translateX(-8px) rotate(-2deg)}50%{transform:translateX(8px) rotate(2deg)}}@keyframes shake{0%,100%{transform:translateX(0)}50%{transform:translateX(8px)}}.msg{min-height:30px;color:var(--green);font-size:15px;margin:14px 0 0}.log{max-height:190px;overflow:auto;font-size:14px}.log div{border-bottom:1px solid #674371;padding:8px 0}.muted{color:#d3b7dc}.fine{font-size:12px}.overlay{position:fixed;inset:0;background:#090612df;z-index:20;display:grid;place-items:center;padding:15px;overflow:auto}.dialog{width:min(760px,100%);border:4px solid var(--green);border-radius:15px;background:#25172e;box-shadow:0 0 35px #84ff4970,9px 10px #07060c;padding:24px;text-align:center}.dialog h2{font:900 clamp(30px,5vw,48px) 'Barlow Condensed';color:var(--green);margin:0 0 10px}.mathline{background:#fff4e5;color:#1b1220;border-radius:9px;padding:16px 10px;font:900 clamp(23px,4vw,37px) 'Barlow Condensed';margin:14px 0;overflow-wrap:anywhere}.arrow{font-size:30px;color:var(--green)}.detail{color:#f7c7f3;font-size:16px}.dialog .btn{margin-top:12px}.footer{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-top:16px}.tinybtn{background:#392344;color:white;border:2px solid #8e60a4;border-radius:8px;padding:8px 12px}.progressSteps{font-size:13px;color:#b7ff89}.warning{color:#ff9cb0}.comic{font:900 20px 'Barlow Condensed';color:var(--pink)}@media(max-width:700px){.intro{grid-template-columns:1fr}.hero{display:none}.levels{grid-template-columns:1fr}.hud{grid-template-columns:repeat(2,1fr)}.tokens{grid-template-columns:repeat(2,1fr)}.token{min-height:76px}.wrap{padding:12px 10px 45px}.panel{padding:13px}.character{font-size:43px;min-width:50px}.objecttitle{font-size:24px}.dialog{padding:14px}.barrow{gap:8px}}
.slime-change{display:inline-block;color:#143014;background:linear-gradient(165deg,#c7ff64 0%,#87f83d 42%,#52cc28 100%);border:2px solid #d3ff8c;border-radius:14px 17px 10px 16px;padding:2px 9px;margin:0 3px;box-shadow:0 0 9px #8cff4d,0 0 22px #72f6359c,inset 0 -5px #369b35;transform:rotate(-1deg);text-shadow:0 1px #dfffaa;animation:slimePulse 1.5s ease-in-out infinite alternate}.slime-change::after{content:' ';position:absolute;width:9px;height:12px;background:#75e83a;border-radius:0 0 9px 9px;bottom:-10px;left:18%;box-shadow:0 0 9px #8cff4d}.slime-change{position:relative}.slime-constant{display:inline-block;color:#122710;background:#aaff51;border:3px solid #efff9c;border-radius:13px;padding:5px 15px;font-size:1.25em;box-shadow:0 0 13px #9bff40,0 0 34px #8aff38,0 0 55px #78ff3770,inset 0 -6px #60be28;text-shadow:1px 1px #dfffaa;animation:slimePulse 1s ease-in-out infinite alternate}.mathline.slime-equation{line-height:1.65;overflow:visible}.slime-caption{font:900 15px Nunito,sans-serif;color:#b4ff76;letter-spacing:.4px;text-transform:uppercase;margin:7px 0}.mathline.slime-equation .equation-before{color:#25182b}@keyframes slimePulse{from{filter:brightness(.95);transform:scale(1)}to{filter:brightness(1.15);transform:scale(1.045)}}@media(prefers-reduced-motion:reduce){.slime-change,.slime-constant{animation:none}}

