.slime-solution{display:inline-flex;align-items:center;justify-content:center;gap:.25em;max-width:100%;padding:13px 26px;margin:12px auto 8px;border:4px solid #dcff9b;border-radius:22px 17px 26px 18px;background:linear-gradient(155deg,#d0ff79,#77ec38 55%,#3cba27);color:#14351b;font-size:clamp(32px,5.8vw,64px);font-weight:1000;letter-spacing:1px;text-shadow:0 2px #e8ffad;box-shadow:0 0 18px #b6ff5d,0 0 45px #66ff42b5,0 12px 0 #317e29,inset 0 -8px #3eaf2b;position:relative;animation:solutionEntrance .65s cubic-bezier(.2,1.5,.4,1) both,solutionWiggle 1.6s ease-in-out .7s infinite alternate}
