
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Miss Millennial Math | Algebra I Arcade</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #faf2f3;
    color: #34252d;
    font-family: system-ui, sans-serif;
}

header {
    text-align: center;
    padding: 48px 20px 32px;
    background: #ead0d7;
    border-bottom: 1px solid #d7aebc;
}

h1 {
    font-size: clamp(2rem, 5vw, 3.6rem);
    margin: 10px 0;
    letter-spacing: -0.04em;
}

header p {
    margin: 8px auto;
    max-width: 600px;
}

small {
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

main {
    max-width: 1100px;
    margin: auto;
    padding: 30px 20px;
}

h2 {
    margin: 0 0 20px;
}

.games {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.game {
    background: white;
    border: 1px solid #e4cbd3;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 5px 15px #5833470b;
}

.emoji {
    font-size: 3rem;
}

.game h3 {
    font-size: 1.4rem;
    margin: 12px 0 6px;
}

.game p {
    line-height: 1.5;
    color: #65515b;
    flex: 1;
}

.play {
    display: block;
    text-align: center;
    background: #713e54;
    color: white;
    text-decoration: none;
    border-radius: 10px;
    padding: 13px;
    font-weight: 750;
}

.play:hover {
    background: #502b3c;
}

.play:focus-visible {
    outline: 3px solid #34252d;
    outline-offset: 3px;
}

footer {
    text-align: center;
    padding: 30px;
    color: #65515b;
}

.soon {
    background: #eee3e7;
    color: #65515b;
    text-align: center;
    padding: 13px;
    border-radius: 10px;
    font-weight: 700;
}
</style>
</head>

<body>

<header>
    <small>Miss Millennial Math</small>
    <h1>Algebra I Arcade</h1>
    <p>Pick a game. Practice your math. Level up your skills!</p>
</header>

<main>

<h2>Choose your adventure</h2>

<div class="games">

    <!-- X-Y BATTLESHIP -->

    <article class="game">
        <div class="emoji">🚢</div>
        <h3>X–Y Battleship</h3>
        <p>Practice navigating the coordinate plane.</p>
        <a class="play" href="x-ybattleship.html">
            Play game →
        </a>
    </article>

    <!-- PIZZA PANIC -->

    <article class="game">
        <div class="emoji">🍕</div>
        <h3>Pizza Panic</h3>
        <p>Put your algebra skills to work in a pizza-themed challenge.</p>
        <a class="play" href="pizzapanic.html">
            Play game →
        </a>
    </article>

    <!-- POLYNOMIAL TOWER -->

    <article class="game">
        <div class="emoji">🦝</div>
        <h3>Polynomial Tower</h3>
        <p>Practice polynomial skills with Carl the raccoon.</p>
        <a class="play" href="polynomialtower.html">
            Play game →
        </a>
    </article>

    <!-- CURSED AND RETURNED -->

    <article class="game">
        <div class="emoji">👻</div>
        <h3>Cursed &amp; Returned</h3>
        <p>Explore a haunted thrift store and tackle math challenges.</p>
        <a class="play" href="cursed-and-returned.html">
            Play game →
        </a>
    </article>

    <!-- TURKEY TARGETS -->

    <article class="game">
        <div class="emoji">🦃</div>
        <h3>Turkey Targets</h3>
        <p>Take aim at your algebra practice.</p>
        <a class="play" href="turkey-targets.html">
            Play game →
        </a>
    </article>

    <!-- SECTOR 13 -->

    <article class="game">
        <div class="emoji">🧪</div>
        <h3>SECTOR 13</h3>
        <p>Master linear inequalities and contain the Anomalies.</p>
        <div id="sector" class="soon">
            Coming soon
        </div>
    </article>

</div>
</main>

<footer>
    Miss Millennial Math · Practice makes progress.
</footer>

<script>
fetch('sector13.html', {
    method: 'HEAD',
    cache: 'no-store'
})
.then(response => {
    if (response.ok) {
        const link = document.createElement('a');
        link.href = 'sector13.html';
        link.className = 'play';
        link.textContent = 'Play game →';
        document.getElementById('sector').replaceWith(link);
    }
})
.catch(() => {});
</script>

</body>
</html>
